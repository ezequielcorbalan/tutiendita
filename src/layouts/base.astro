---
import { LANG_HTML } from "../i18n";
import "../estilos/tienda.css";

interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang={LANG_HTML[Astro.locals.idioma ?? "es"]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <slot name="head" />
  </head>
  <body>
    <slot name="arriba" />
    <main>
      <slot />
    </main>
    <slot name="abajo" />
  </body>
</html>
