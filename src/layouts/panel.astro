---
import PanelBar, { type PanelSection } from "../components/panel-bar.astro";
import { texts } from "../i18n";
import { STORE_VERSION } from "../version";
import Base from "./base.astro";

interface Props {
  title: string;
  /** "Paso n de 5" during onboarding. */
  step?: number;
  /** Signed in and the store ready: shows the top bar with this section marked. */
  section?: PanelSection;
}
const { title, step, section } = Astro.props;
const t = texts(Astro.locals.language);
---

<Base title={`${title} · tiendita`} index={false}>
  {section && <PanelBar slot="top" section={section} />}
  <div class:list={["panel", { "panel--wide": section }]}>
    {step !== undefined && <p class="step" style={`--step: ${step / 5}`}>{t.panel.stepOf(step)}</p>}
    <slot />
  </div>
  {
    section && (
      <footer slot="bottom" class="panel-footer">
        <p>
          {t.navPanel.footer(STORE_VERSION)} <a href="https://tutiendita.ar">tutiendita.ar</a> ·{" "}
          <a href="https://github.com/ezequielcorbalan/tutiendita">{t.navPanel.code}</a>
        </p>
      </footer>
    )
  }
</Base>
