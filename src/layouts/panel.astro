---
import { textos } from "../i18n";
import Base from "./base.astro";

interface Props {
  titulo: string;
  /** "Paso n de 5" en el primer ingreso. */
  paso?: number;
}
const { titulo, paso } = Astro.props;
const t = textos(Astro.locals.idioma);
---

<Base titulo={`${titulo} · tiendita`}>
  <meta slot="head" name="robots" content="noindex" />
  <div class="panel">
    {paso !== undefined && <p class="paso" style={`--paso: ${paso / 5}`}>{t.panel.pasoDe(paso)}</p>}
    <slot />
  </div>
</Base>
