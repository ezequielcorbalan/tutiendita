---
import { CATALOGO_DE_EJEMPLO, IDIOMA_POR_DEFECTO, RUBROS_DE_EJEMPLO } from "../paquetes/core/index";
import { textos } from "../i18n";

/**
 * Cargar productos de ejemplo de un rubro (y, en el panel, borrarlos todos). En el primer ingreso, cargar
 * también completa el paso del producto (`despues="avanzar"`); en el panel recarga la página.
 */
interface Props {
  intro: string;
  despues: "avanzar" | "recargar";
  conBorrar?: boolean;
}
const { intro, despues, conBorrar = false } = Astro.props;
const idioma = Astro.locals.idioma ?? IDIOMA_POR_DEFECTO;
const t = textos(idioma).ejemplos;
---

<h2>{t.titulo}</h2>
<p>{intro}</p>
<form data-ejemplos data-despues={despues}>
  <label for="rubro">{t.etiquetaRubro}</label>
  <select id="rubro" name="rubro">
    {RUBROS_DE_EJEMPLO.map((r) => <option value={r}>{CATALOGO_DE_EJEMPLO[r].nombre[idioma]}</option>)}
  </select>
  <button type="submit" class="secundario">{t.cargar}</button>
  {conBorrar && <button type="button" class="secundario" data-borrar-ejemplos>{t.borrar}</button>}
  <p class="error" data-error role="alert"></p>
</form>

<script>
  import { avanzar, elemento, mostrarError, pedir, t } from "../scripts/panel";

  const formulario = elemento<HTMLFormElement>("[data-ejemplos]");
  const error = formulario.querySelector("[data-error]");
  const botones = [...formulario.querySelectorAll("button")];
  const ocupado = (si: boolean) => {
    for (const b of botones) b.disabled = si;
  };

  formulario.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const boton = formulario.querySelector<HTMLButtonElement>("button[type=submit]");
    const texto = boton?.textContent ?? "";
    ocupado(true);
    if (boton) boton.textContent = t().ejemplos.cargando;
    try {
      await pedir("POST", "/api/ejemplos", { rubro: String(new FormData(formulario).get("rubro") ?? "") });
      if (formulario.dataset.despues === "avanzar") await avanzar("producto");
      else location.reload();
    } catch (e) {
      mostrarError(error, e);
      ocupado(false);
      if (boton) boton.textContent = texto;
    }
  });

  formulario.querySelector("[data-borrar-ejemplos]")?.addEventListener("click", async () => {
    if (!confirm(t().ejemplos.confirmarBorrar)) return;
    ocupado(true);
    try {
      await pedir("DELETE", "/api/ejemplos");
      location.reload();
    } catch (e) {
      mostrarError(error, e);
      ocupado(false);
    }
  });
</script>
