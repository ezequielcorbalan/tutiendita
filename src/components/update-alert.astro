---
/**
 * Alert for an update that fixes a security problem or bugs (nothing for a feature update). Shown on the
 * Updates page and, through the /panel/actualizaciones/aviso partial, on the panel home.
 */
import type { UpdateKind } from "../packages/core/index";
import { texts } from "../i18n";

interface Props {
  kind: UpdateKind;
  version: string;
  /** On the panel home: a link to the Updates page. */
  link?: boolean;
}
const { kind, version, link = false } = Astro.props;
const t = texts(Astro.locals.language).updates;
const security = kind === "security";
// Stroke icons (24×24, stroke 2) like the panel bar's, decorative: the title says what it is.
const icon = security
  ? "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3zM12 8v5M12 16h.01"
  : "M14.7 6.3a4 4 0 0 0 5 5l-9.4 9.4a2.1 2.1 0 0 1-3-3l9.4-9.4a4 4 0 0 0-2-2z";
---

{
  kind !== "feature" && (
    <div class:list={["update-alert", `update-alert--${kind}`]} role={security ? "alert" : "status"}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d={icon} />
      </svg>
      <div>
        <p class="update-alert__title">{security ? t.securityTitle : t.bugfixTitle}</p>
        <p>{security ? t.securityText(version) : t.bugfixText(version)}</p>
        {link && (
          <p>
            <a class="button" href="/panel/actualizaciones">
              {t.review}
            </a>
          </p>
        )}
      </div>
    </div>
  )
}
