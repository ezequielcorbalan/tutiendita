---
/**
 * Selector del idioma de la tienda (primer ingreso y panel). Un <select> nativo con su <label> y la ayuda
 * enlazada por aria-describedby: accesible con teclado y lector de pantalla sin código extra. Cada opción
 * está escrita en su propio idioma y lo declara con `lang`.
 */
import { IDIOMAS, type Idioma } from "../paquetes/core/index";
import { LANG_HTML, NOMBRES_DE_IDIOMA, textos } from "../i18n";

interface Props {
  actual: Idioma;
}
const { actual } = Astro.props;
const t = textos(Astro.locals.idioma).idioma;
---

<label for="idioma">{t.etiqueta}</label>
<select id="idioma" name="idioma" aria-describedby="idioma-ayuda">
  {
    IDIOMAS.map((idioma) => (
      <option value={idioma} lang={LANG_HTML[idioma]} selected={idioma === actual}>
        {NOMBRES_DE_IDIOMA[idioma]}
      </option>
    ))
  }
</select>
<p id="idioma-ayuda"><small>{t.ayuda}</small></p>
