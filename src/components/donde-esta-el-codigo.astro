---
// Dónde encuentra el comerciante el código de reclamo. Lo usan la portada de primer
// arranque y /panel/reclamar; el README del repo generado repite lo mismo.
import { textos } from "../i18n";

const t = textos(Astro.locals.idioma).dondeEstaElCodigo;
---

<ol>
  {t.pasosHtml.map((paso) => <li set:html={paso} />)}
</ol>
<p set:html={t.notaHtml} />
