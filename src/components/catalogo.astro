---
import { textos } from "../i18n";
import type { DatosInicio } from "../lib/paginas";

/** El catálogo público: navegación por categoría (si hay) y la lista de productos. Lo usan / y /c/<slug>. */
interface Props {
  datos: Extract<DatosInicio, { estado: "lista" }>;
}
const { datos } = Astro.props;
const t = textos(Astro.locals.idioma).tienda;
const actual = datos.categoriaActual?.slug;
---

<h1>{datos.nombre}</h1>
{
  datos.categorias.length > 0 && (
    <nav class="categorias" aria-label={t.categorias}>
      <ul>
        <li>
          <a href="/" aria-current={actual === undefined ? "page" : undefined}>{t.todos}</a>
        </li>
        {datos.categorias.map((c) => (
          <li>
            <a href={`/c/${c.slug}`} aria-current={actual === c.slug ? "page" : undefined}>{c.nombre}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
{datos.categoriaActual && <h2>{datos.categoriaActual.nombre}</h2>}
{
  datos.productos.length === 0 ? (
    <p>{t.sinProductos}</p>
  ) : (
    <ul class="catalogo">
      {datos.productos.map((p) => (
        <li class="producto">
          <a href={`/p/${p.slug}`}>
            {p.imagenes[0] && (
              <img src={p.imagenes[0].url} alt={p.nombre} width="160" height="160" loading="lazy" />
            )}
            <strong>{p.nombre}</strong>
          </a>
          <span class="precio">{p.precioTexto}</span>
        </li>
      ))}
    </ul>
  )
}
