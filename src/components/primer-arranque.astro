---
import { textos } from "../i18n";
import Base from "../layouts/base.astro";
import DondeEstaElCodigo from "./donde-esta-el-codigo.astro";

// Primer arranque: lo que ve el comerciante al abrir la dirección que le dio el botón
// "Deploy to Cloudflare", antes de reclamar su tienda.
const t = textos(Astro.locals.idioma).primerArranque;
---

<Base titulo={t.titulo} descripcion={t.descripcion}>
  <h1>{t.titulo}</h1>
  <p>{t.intro}</p>
  <ul>
    {t.recursosHtml.map((recurso) => <li set:html={recurso} />)}
  </ul>
  <h2>{t.queSigue}</h2>
  <p set:html={t.reclamoHtml} />
  <DondeEstaElCodigo />
  <p><a href="/panel/reclamar"><strong>{t.boton}</strong></a></p>
  <p>{t.despues}</p>
  <p set:html={t.instruccionesHtml} />
</Base>
