---
/** One line of release notes: text with **bold**, *italics* and `code`, always escaped by Astro. */
import type { Inline } from "../lib/release-notes";

interface Props {
  parts: Inline[];
}
const { parts } = Astro.props;
---

{
  parts.map((p) => {
    const text = p.code ? <code>{p.text}</code> : p.em ? <em>{p.text}</em> : p.text;
    return p.strong ? <strong>{text}</strong> : text;
  })
}
