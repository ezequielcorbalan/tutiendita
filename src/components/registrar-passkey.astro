---
/**
 * Botón "Crear mi passkey" + muestra del código de recuperación cuando el servidor emite uno (reclamo o
 * recuperación). Se usa en el paso 1, en /panel/recuperar y en /panel/acceso.
 */
import { textos } from "../i18n";

interface Props {
  /** A dónde ir al terminar (después de confirmar el código, si hubo). */
  siguiente: string;
  /** Paso del primer ingreso que se completa al terminar. */
  paso?: string;
  texto?: string;
}
const t = textos(Astro.locals.idioma);
const { siguiente, paso, texto = t.passkey.crear } = Astro.props;
---

<div data-registrar-passkey data-siguiente={siguiente} data-paso={paso ?? ""}>
  <p data-sin-soporte hidden>{t.comun.sinPasskeys}</p>
  <button type="button" data-crear>{texto}</button>
  <p class="error" data-error role="alert"></p>
  <div data-codigo hidden></div>
</div>

<script>
  import {
    avanzar,
    browserSupportsWebAuthn,
    mostrarCodigoDeRecuperacion,
    mostrarError,
    registrarPasskey,
  } from "../scripts/panel";

  for (const bloque of document.querySelectorAll<HTMLElement>("[data-registrar-passkey]")) {
    const boton = bloque.querySelector<HTMLButtonElement>("[data-crear]");
    const error = bloque.querySelector("[data-error]");
    const codigo = bloque.querySelector<HTMLElement>("[data-codigo]");
    const { siguiente = "/panel", paso = "" } = bloque.dataset;
    const terminar = async () => {
      try {
        if (paso) await avanzar(paso);
        else location.assign(siguiente);
      } catch (e) {
        mostrarError(error, e);
      }
    };
    if (!browserSupportsWebAuthn()) {
      bloque.querySelector<HTMLElement>("[data-sin-soporte]")?.removeAttribute("hidden");
      if (boton) boton.disabled = true;
      continue;
    }
    boton?.addEventListener("click", async () => {
      boton.disabled = true;
      if (error) error.textContent = "";
      try {
        const r = await registrarPasskey();
        boton.hidden = true;
        if (r.codigoDeRecuperacion && codigo) mostrarCodigoDeRecuperacion(codigo, r.codigoDeRecuperacion, terminar);
        else await terminar();
      } catch (e) {
        mostrarError(error, e);
        boton.disabled = false;
      }
    });
  }
</script>
