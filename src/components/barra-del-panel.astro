---
/**
 * Barra superior del panel (con sesión y la tienda lista): marca, navegación entre secciones con la actual
 * marcada (aria-current) y, separadas, las acciones de ver la tienda y salir.
 */
import { textos } from "../i18n";

export type SeccionDelPanel = "inicio" | "productos" | "actualizaciones" | "acceso";
interface Props {
  seccion: SeccionDelPanel;
}
const { seccion } = Astro.props;
const t = textos(Astro.locals.idioma);
const n = t.navPanel;
// Íconos de trazo simple (24×24, trazo 2), decorativos: el texto los nombra.
const ICONOS: Record<SeccionDelPanel, string> = {
  inicio: "M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10",
  productos: "M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8",
  actualizaciones: "M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7",
  acceso: "M7 14a4 4 0 1 1 3.9-5H21v3h-2v3h-3v-3h-5.1A4 4 0 0 1 7 14z",
};
const secciones: { id: SeccionDelPanel; href: string; texto: string }[] = [
  { id: "inicio", href: "/panel", texto: n.inicio },
  { id: "productos", href: "/panel/productos", texto: n.productos },
  { id: "actualizaciones", href: "/panel/actualizaciones", texto: n.actualizaciones },
  { id: "acceso", href: "/panel/acceso", texto: n.acceso },
];
---

<header class="barra-panel">
  <div class="barra-panel__contenido">
    <a class="barra-panel__marca" href="/panel">
      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="5" y="14" width="22" height="14" rx="2" fill="currentColor" opacity="0.18"></rect>
        <path class="toldo" d="M4 12l3-7h18l3 7a4 4 0 0 1-8 0 4 4 0 0 1-8 0 4 4 0 0 1-8 0z"></path>
        <rect class="puerta" x="13" y="19" width="6" height="9" rx="1"></rect>
      </svg>
      <span>{n.marca}</span>
    </a>
    <nav aria-label={n.etiqueta}>
      <ul>
        {
          secciones.map((s) => (
            <li>
              <a href={s.href} aria-current={s.id === seccion ? "page" : undefined}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={ICONOS[s.id]} />
                </svg>
                {s.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="barra-panel__acciones">
      <a class="boton secundario" href="/" target="_blank" rel="noopener">{n.verTienda}</a>
      <button type="button" class="secundario" data-salir>{t.inicioPanel.salir}</button>
    </div>
  </div>
</header>

<script>
  import { pedir } from "../scripts/panel";

  document.querySelector("[data-salir]")?.addEventListener("click", async () => {
    await pedir("POST", "/api/acceso/salir").catch(() => undefined);
    location.assign("/panel/ingresar");
  });
</script>
