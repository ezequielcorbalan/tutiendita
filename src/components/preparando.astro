---
import { textos } from "../i18n";
import Base from "../layouts/base.astro";

// Portada mientras el primer ingreso está a medias: todavía no se muestra el catálogo.
const t = textos(Astro.locals.idioma).preparando;
---

<Base titulo={t.titulo} descripcion={t.descripcion}>
  <h1>{t.titulo}</h1>
  <p>{t.texto}</p>
  <p><small set:html={t.esTuTiendaHtml} /></p>
</Base>
