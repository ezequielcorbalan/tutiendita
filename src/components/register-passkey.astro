---
/**
 * "Crear mi passkey" button + showing the recovery code when the server issues one (claim or
 * recovery). Used in step 1, in /panel/recuperar and in /panel/acceso. In step 1 (`allowKey`) there is also a
 * password option for devices without passkeys.
 */
import { texts } from "../i18n";

interface Props {
  /** Where to go when done (after confirming the code, if there was one). */
  next: string;
  /** Onboarding step completed when done. */
  step?: string;
  text?: string;
  /** Offers a password instead of a passkey (claim only: devices without passkeys). */
  allowKey?: boolean;
}
const t = texts(Astro.locals.language);
const { next, step, text = t.passkey.create, allowKey = false } = Astro.props;
---

<div data-register-passkey data-next={next} data-step={step ?? ""}>
  <p data-unsupported hidden>{t.common.noPasskeys}</p>
  <button type="button" data-create>{text}</button>
  {
    allowKey && (
      <>
        <button type="button" class="secondary" data-create-key>{t.passkey.useKey}</button>
        <form data-key-form hidden>
          <label for="claim-password">{t.password.newLabel}</label>
          <input id="claim-password" type="password" autocomplete="new-password" minlength="12" required />
          <label for="claim-password-repeat">{t.password.repeatLabel}</label>
          <input id="claim-password-repeat" type="password" autocomplete="new-password" required />
          <p><small>{t.password.rules}</small></p>
          <button type="submit">{t.password.submit}</button>
        </form>
      </>
    )
  }
  <p class="error" data-error role="alert"></p>
  <div data-code hidden></div>
</div>

<script>
  import {
    advance,
    browserSupportsWebAuthn,
    claimWithPassword,
    showRecoveryCode,
    showError,
    registerPasskey,
    t,
  } from "../scripts/panel";

  for (const block of document.querySelectorAll<HTMLElement>("[data-register-passkey]")) {
    const button = block.querySelector<HTMLButtonElement>("[data-create]");
    const keyButton = block.querySelector<HTMLButtonElement>("[data-create-key]");
    const keyForm = block.querySelector<HTMLFormElement>("[data-key-form]");
    const error = block.querySelector("[data-error]");
    const code = block.querySelector<HTMLElement>("[data-code]");
    const { next = "/panel", step = "" } = block.dataset;
    const finish = async () => {
      try {
        if (step) await advance(step);
        else location.assign(next);
      } catch (e) {
        showError(error, e);
      }
    };
    // Without WebAuthn the passkey button stays disabled, but the password option still works.
    if (!browserSupportsWebAuthn()) {
      block.querySelector<HTMLElement>("[data-unsupported]")?.removeAttribute("hidden");
      if (button) button.disabled = true;
    }
    button?.addEventListener("click", async () => {
      button.disabled = true;
      if (error) error.textContent = "";
      try {
        const r = await registerPasskey();
        button.hidden = true;
        if (r.recoveryCode && code) showRecoveryCode(code, r.recoveryCode, finish);
        else await finish();
      } catch (e) {
        showError(error, e);
        button.disabled = false;
      }
    });
    keyButton?.addEventListener("click", () => {
      if (error) error.textContent = "";
      if (keyForm) keyForm.hidden = false;
      keyButton.hidden = true;
    });
    keyForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (error) error.textContent = "";
      const password = keyForm.querySelector<HTMLInputElement>("#claim-password")?.value ?? "";
      const repeat = keyForm.querySelector<HTMLInputElement>("#claim-password-repeat")?.value ?? "";
      if (password !== repeat) {
        if (error) error.textContent = t().password.mismatch;
        return;
      }
      try {
        await claimWithPassword(password);
        if (button) button.hidden = true;
        keyForm.hidden = true;
        await finish();
      } catch (e) {
        showError(error, e);
      }
    });
  }
</script>
