---
import { env } from "cloudflare:workers";
import SampleProducts from "../../components/sample-products.astro";
import { texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";
import { panelProductsData } from "../../lib/pages";

const all = texts(Astro.locals.language);
const t = all.panelProducts;
const products = await panelProductsData(env, Astro.locals.language);
---

<Panel title={t.title} section="products">
  <h1>{t.title}</h1>
  {Astro.url.searchParams.has("created") && <p role="status">{all.newProduct.created}</p>}
  <p><a class="button" href="/panel/productos/nuevo">{all.newProduct.action}</a></p>
  {
    products.length === 0 ? (
      <p>{t.noProducts}</p>
    ) : (
      <table>
        <thead>
          <tr>
            <th scope="col">{t.photo}</th>
            <th scope="col">{t.name}</th>
            <th scope="col">{t.price}</th>
            <th scope="col">{t.status}</th>
          </tr>
        </thead>
        <tbody>
          {products.map((p) => (
            <tr>
              <td>
                {/* empty alt: the name is in the next cell */}
                {p.images[0] && <img src={p.images[0].url} alt="" width="64" height="64" loading="lazy" />}
              </td>
              <th scope="row">{p.status === "publicado" ? <a href={`/p/${p.slug}`}>{p.name}</a> : p.name}</th>
              <td>{p.priceText}</td>
              <td>{t.statuses[p.status]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
  <SampleProducts intro={all.samples.introPanel} after="reload" withDelete />
  <p><a href="/panel">{all.access.backToPanel}</a></p>
</Panel>
