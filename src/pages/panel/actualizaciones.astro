---
import { env } from "cloudflare:workers";
import UpdateAlert from "../../components/update-alert.astro";
import { build } from "../../container";
import { texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";
import { cookieName, cookieOptions } from "../../lib/cookies";
import { appManifest, GITHUB_STATE_COOKIE, random, STATE_TTL_SECONDS } from "../../lib/github-manifest";
import { STORE_VERSION } from "../../version";

const container = build(env);
const t = texts(Astro.locals.language).updates;
const [status, connection, store] = await Promise.all([
  container.updates.status(STORE_VERSION),
  container.updates.getConnection(),
  container.getStore(),
]);

let manifest = "";
let githubState = "";
if (status.ok && status.value.status === "not-connected") {
  githubState = random(16);
  Astro.cookies.set(cookieName(GITHUB_STATE_COOKIE, Astro.url), githubState, {
    ...cookieOptions(Astro.url, STATE_TTL_SECONDS),
    sameSite: "lax",
  });
  manifest = JSON.stringify(
    appManifest({
      origin: Astro.url.origin,
      storeName: store?.name ?? "",
      suffix: random(2),
    }),
  );
}
---

<Panel title={t.title} section="updates">
  <h1>{t.title}</h1>
  <p>{t.intro}</p>
  <p>{t.version(STORE_VERSION)}</p>
  {!status.ok && <p class="error" role="alert">{t.errorStatus}</p>}
  {
    status.ok && status.value.status === "not-connected" && (
      <section aria-labelledby="connect">
        <h2 id="connect">{t.connectTitle}</h2>
        <p>{t.connectText}</p>
        <form method="post" action={`https://github.com/settings/apps/new?state=${githubState}`}>
          <input type="hidden" name="manifest" value={manifest} />
          <button type="submit">{t.connect}</button>
        </form>
      </section>
    )
  }
  {
    status.ok && status.value.status === "not-installed" && (
      <section aria-labelledby="install">
        <h2 id="install">{t.installTitle}</h2>
        <p>{t.installText}</p>
        <p>
          <a class="button" href={`https://github.com/apps/${status.value.slug}/installations/new`}>
            {t.install}
          </a>
        </p>
      </section>
    )
  }
  {
    status.ok && status.value.status === "wrong-repository" ? (
      <section aria-labelledby="wrong-repo">
        <h2 id="wrong-repo">{t.wrongRepoTitle}</h2>
        <p class="error" role="alert">{t.wrongRepoText(status.value.repositories.join(", "))}</p>
        <p>
          <a class="button" href={`https://github.com/settings/installations/${status.value.installationId}`}>
            {t.wrongRepoAction}
          </a>
        </p>
      </section>
    ) : (
      connection?.repository && <p>{t.connected(connection.repository)}</p>
    )
  }
  {status.ok && status.value.status === "up-to-date" && <p>{t.upToDate(status.value.current)}</p>}
  {
    status.ok && status.value.status === "update-available" && (
      <section aria-labelledby="new-version" data-update>
        <h2 id="new-version">{t.updateAvailable(status.value.newVersion, status.value.current)}</h2>
        <UpdateAlert kind={status.value.kind} version={status.value.newVersion} />
        <p>{t.prepareText}</p>
        <button type="button" data-prepare>
          {t.prepare}
        </button>
        <div data-prepared hidden>
          <p data-summary />
          <p>
            <a data-pr target="_blank" rel="noopener">
              {t.viewOnGithub}
            </a>
          </p>
          <p>{t.notice}</p>
          <button type="button" data-apply>
            {t.apply}
          </button>
        </div>
        <p data-applied hidden role="status">
          {t.applied}
        </p>
        <p class="error" data-error role="alert" />
      </section>
    )
  }
  <p><a href="/panel">{texts(Astro.locals.language).access.backToPanel}</a></p>
</Panel>

<script>
  import { showError, request, t } from "../../scripts/panel";

  const section = document.querySelector<HTMLElement>("[data-update]");
  if (section) {
    const error = section.querySelector("[data-error]");
    const prepare = section.querySelector<HTMLButtonElement>("[data-prepare]");
    const apply = section.querySelector<HTMLButtonElement>("[data-apply]");
    let number = 0;
    prepare?.addEventListener("click", async () => {
      prepare.disabled = true;
      try {
        const r = await request<{ number: number; url: string; files: number }>("POST", "/api/updates/prepare");
        number = r.number;
        const summary = section.querySelector("[data-summary]");
        if (summary) summary.textContent = t().updates.prepared(r.files);
        section.querySelector<HTMLAnchorElement>("[data-pr]")?.setAttribute("href", r.url);
        section.querySelector<HTMLElement>("[data-prepared]")?.removeAttribute("hidden");
        prepare.hidden = true;
      } catch (e) {
        prepare.disabled = false;
        showError(error, e);
      }
    });
    apply?.addEventListener("click", async () => {
      apply.disabled = true;
      try {
        await request("POST", "/api/updates/apply", { number });
        section.querySelector<HTMLElement>("[data-prepared]")?.setAttribute("hidden", "");
        section.querySelector<HTMLElement>("[data-applied]")?.removeAttribute("hidden");
      } catch (e) {
        apply.disabled = false;
        showError(error, e);
      }
    });
  }
</script>
