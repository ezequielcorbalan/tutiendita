---
import { texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";

const t = texts(Astro.locals.language).signIn;
---

<Panel title={t.pageTitle}>
  <h1>{t.title}</h1>
  <p>{t.intro}</p>
  <!-- The field enables passkey autofill in the browsers that support it. -->
  <label for="username">{t.label}</label>
  <input id="username" name="username" autocomplete="username webauthn" placeholder={t.placeholder} />
  <button type="button" data-sign-in>{t.button}</button>
  <p class="error" data-error role="alert"></p>
  <p data-unsupported hidden>{t.unsupported}</p>
  <p><a href="/panel/recuperar">{t.lostMyDevice}</a></p>
  <h2>{t.keyTitle}</h2>
  <label for="access-key">{t.keyLabel}</label>
  <input id="access-key" name="access-key" type="password" autocomplete="current-password" />
  <button type="button" class="secondary" data-sign-in-key>{t.keyButton}</button>
  <p class="error" data-key-error role="alert"></p>
</Panel>

<script>
  import { browserSupportsWebAuthn, element, signInWithPasskey, signInWithPassword, showError } from "../../scripts/panel";

  const error = element("[data-error]");
  const button = element<HTMLButtonElement>("[data-sign-in]");
  if (!browserSupportsWebAuthn()) {
    element("[data-unsupported]").hidden = false;
    button.disabled = true;
  } else {
    signInWithPasskey(true)
      .then((entered) => entered && location.assign("/panel"))
      .catch(() => {
        // Autofill cancels itself when the button is tapped; it's not an error to show.
      });
    button.addEventListener("click", async () => {
      error.textContent = "";
      try {
        await signInWithPasskey(false);
        location.assign("/panel");
      } catch (e) {
        showError(error, e);
      }
    });
  }

  // Works on any device: no passkey involved.
  const keyError = element("[data-key-error]");
  const keyInput = element<HTMLInputElement>("#access-key");
  element<HTMLButtonElement>("[data-sign-in-key]").addEventListener("click", async () => {
    keyError.textContent = "";
    try {
      await signInWithPassword(keyInput.value);
      location.assign("/panel");
    } catch (e) {
      showError(keyError, e);
    }
  });
</script>
