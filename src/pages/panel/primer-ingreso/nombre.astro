---
import { env } from "cloudflare:workers";
import SelectorDeIdioma from "../../../components/selector-de-idioma.astro";
import { armar } from "../../../container";
import { textos } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

// Pantalla 2: nombre e idioma de la tienda (por defecto español). Desde la pantalla 3 todo sale en ese idioma.
const tienda = await armar(env).obtenerTienda();
const t = textos(Astro.locals.idioma);
---

<Panel titulo={t.pasoNombre.tituloPagina} paso={2}>
  <h1>{t.pasoNombre.titulo}</h1>
  <form data-formulario>
    <label for="nombre">{t.pasoNombre.etiqueta}</label>
    <input id="nombre" name="nombre" required maxlength="80" placeholder={t.pasoNombre.placeholder} value={tienda?.nombre ?? ""} />
    <SelectorDeIdioma actual={tienda?.idioma ?? "es"} />
    <button type="submit">{t.comun.continuar}</button>
    <p class="error" data-error role="alert"></p>
  </form>
  <p><a href="/panel/primer-ingreso/acceso">{t.comun.volver}</a></p>
</Panel>

<script>
  import { avanzar, elemento, mostrarError, pedir } from "../../../scripts/panel";

  const formulario = elemento<HTMLFormElement>("[data-formulario]");
  formulario.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const datos = new FormData(formulario);
    try {
      await pedir("PUT", "/api/tienda", {
        nombre: String(datos.get("nombre") ?? ""),
        idioma: String(datos.get("idioma") ?? ""),
      });
      await avanzar("nombre");
    } catch (e) {
      mostrarError(formulario.querySelector("[data-error]"), e);
    }
  });
</script>
