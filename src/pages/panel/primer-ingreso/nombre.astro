---
import { env } from "cloudflare:workers";
import LanguageSelector from "../../../components/language-selector.astro";
import { build } from "../../../container";
import { texts } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

// Screen 2: store name and language (Spanish by default). From screen 3 on everything is in that language.
const store = await build(env).getStore();
const t = texts(Astro.locals.language);
---

<Panel title={t.nameStep.pageTitle} step={2}>
  <h1>{t.nameStep.title}</h1>
  <form data-form>
    <label for="name">{t.nameStep.label}</label>
    <input id="name" name="name" required maxlength="80" placeholder={t.nameStep.placeholder} value={store?.name ?? ""} />
    <LanguageSelector current={store?.language ?? "es"} />
    <button type="submit">{t.common.continue}</button>
    <p class="error" data-error role="alert"></p>
  </form>
  <p><a href="/panel/primer-ingreso/acceso">{t.common.back}</a></p>
</Panel>

<script>
  import { advance, element, showError, request } from "../../../scripts/panel";

  const form = element<HTMLFormElement>("[data-form]");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    try {
      await request("PUT", "/api/store", {
        name: String(data.get("name") ?? ""),
        language: String(data.get("language") ?? ""),
      });
      await advance("nombre");
    } catch (e) {
      showError(form.querySelector("[data-error]"), e);
    }
  });
</script>
