---
import { env } from "cloudflare:workers";
import { armar } from "../../../container";
import { textos } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

const actual = await armar(env).obtenerMedioDePago("transferencia");
const t = textos(Astro.locals.idioma);
---

<Panel titulo={t.pasoTransferencia.tituloPagina} paso={4}>
  <h1>{t.pasoTransferencia.titulo}</h1>
  <p>{t.pasoTransferencia.intro}</p>
  <form data-formulario>
    <label for="cuenta">{t.pasoTransferencia.etiquetaCuenta}</label>
    <input id="cuenta" name="cuenta" required autocomplete="off" spellcheck="false" placeholder={t.pasoTransferencia.placeholderCuenta} value={actual?.configuracion.cuenta ?? ""} />
    <label for="titular">{t.pasoTransferencia.etiquetaTitular}</label>
    <input id="titular" name="titular" required maxlength="80" autocomplete="name" placeholder={t.pasoTransferencia.placeholderTitular} value={actual?.configuracion.titular ?? ""} />
    <button type="submit">{t.comun.continuar}</button>
    <button type="button" class="secundario" data-saltear>{t.pasoTransferencia.saltear}</button>
    <p class="error" data-error role="alert"></p>
  </form>
  <p><a href="/panel/primer-ingreso/whatsapp">{t.comun.volver}</a></p>
</Panel>

<script>
  import { avanzar, elemento, mostrarError, pedir } from "../../../scripts/panel";

  const formulario = elemento<HTMLFormElement>("[data-formulario]");
  const error = formulario.querySelector("[data-error]");
  formulario.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const datos = new FormData(formulario);
    try {
      await pedir("PUT", "/api/medios-de-pago/transferencia", {
        cuenta: String(datos.get("cuenta") ?? ""),
        titular: String(datos.get("titular") ?? ""),
      });
      await avanzar("transferencia");
    } catch (e) {
      mostrarError(error, e);
    }
  });
  elemento("[data-saltear]").addEventListener("click", () => avanzar("transferencia", true).catch((e) => mostrarError(error, e)));
</script>
