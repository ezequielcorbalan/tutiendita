---
import { env } from "cloudflare:workers";
import SampleProducts from "../../../components/sample-products.astro";
import { build } from "../../../container";
import { texts } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

const container = build(env);
const currency = (await container.getStore())?.currency ?? "ARS";
const photoMode = container.hasBucket ? "professional" : "basic";
const t = texts(Astro.locals.language);
---

<Panel title={t.productStep.pageTitle} step={5}>
  <h1>{t.productStep.title}</h1>
  <p>{t.productStep.intro}</p>
  <form data-form data-currency={currency} data-photo-mode={photoMode}>
    <label for="name">{t.productStep.nameLabel}</label>
    <input id="name" name="name" required maxlength="120" placeholder={t.productStep.namePlaceholder} />
    <label for="price">{t.productStep.priceLabel(currency)}</label>
    <input id="price" name="price" required inputmode="decimal" placeholder="2500" />
    <label for="image">{t.productStep.photoLabel}</label>
    <input id="image" name="image" type="file" required accept="image/jpeg,image/png,image/webp" />
    <button type="submit">{t.productStep.publish}</button>
    <button type="button" class="secondary" data-skip>{t.productStep.skip}</button>
    <p class="error" data-error role="alert"></p>
  </form>
  <SampleProducts intro={t.samples.introOnboarding} after="advance" />
  <p><a href="/panel/primer-ingreso/transferencia">{t.common.back}</a></p>
</Panel>

<script>
  import { shrinkImage } from "../../../lib/shrink-image";
  import { advance, element, request, showError, toMinorUnits } from "../../../scripts/panel";

  const form = element<HTMLFormElement>("[data-form]");
  const error = form.querySelector("[data-error]");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    // Disabled before the first await: shrinking takes a moment and a second click must not send twice.
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    const data = new FormData(form);
    const creation = new FormData();
    creation.set("name", String(data.get("name") ?? ""));
    creation.set("price_amount", toMinorUnits(String(data.get("price") ?? "")));
    creation.set("price_currency", form.dataset.currency ?? "ARS");
    creation.set("publish", "true");
    const image = data.get("image");
    if (image instanceof File && image.size > 0) creation.set(
        "image",
        await shrinkImage(image, form.dataset.photoMode === "professional" ? "professional" : "basic"),
      );
    try {
      await request("POST", "/api/products", creation);
      await advance("producto");
    } catch (e) {
      if (submit) submit.disabled = false;
      showError(error, e);
    }
  });
  element("[data-skip]").addEventListener("click", () => advance("producto", true).catch((e) => showError(error, e)));
</script>
