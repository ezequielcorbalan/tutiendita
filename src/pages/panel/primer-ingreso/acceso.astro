---
import RegistrarPasskey from "../../../components/registrar-passkey.astro";
import { textos } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

// Pantalla 1: passkey + código de recuperación. Con sesión de reclamo, la primera passkey reclama la tienda;
// si ya hay dueño (se volvió atrás), ofrece agregar otro dispositivo y seguir.
const yaTieneDueno = Astro.locals.panel?.sesion === "completa";
const t = textos(Astro.locals.idioma);
---

<Panel titulo={t.pasoAcceso.tituloPagina} paso={1}>
  <h1>{t.pasoAcceso.titulo}</h1>
  <p>{t.pasoAcceso.intro}</p>
  {
    yaTieneDueno ? (
      <>
        <p>{t.pasoAcceso.yaCreada}</p>
        <RegistrarPasskey siguiente="/panel/primer-ingreso/acceso" texto={t.pasoAcceso.agregarOtro} />
        <p>
          <button type="button" data-seguir>{t.comun.continuar}</button>
        </p>
      </>
    ) : (
      <RegistrarPasskey siguiente="/panel/primer-ingreso/nombre" paso="acceso" />
    )
  }
  <p class="error" data-error-seguir role="alert"></p>
  <p>
    <small>{t.pasoAcceso.aviso}</small>
  </p>
</Panel>

<script>
  import { avanzar, mostrarError } from "../../../scripts/panel";

  document.querySelector("[data-seguir]")?.addEventListener("click", async () => {
    try {
      await avanzar("acceso");
    } catch (e) {
      mostrarError(document.querySelector("[data-error-seguir]"), e);
    }
  });
</script>
