---
import RegisterPasskey from "../../../components/register-passkey.astro";
import { texts } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

// Screen 1: passkey + recovery code. With a claim session, the first passkey claims the store; if there's
// already an owner (they went back), offers adding another device and moving on. Steps are stored literals.
const alreadyHasOwner = Astro.locals.panel?.session === "completa";
const t = texts(Astro.locals.language);
---

<Panel title={t.accessStep.pageTitle} step={1}>
  <h1>{t.accessStep.title}</h1>
  <p>{t.accessStep.intro}</p>
  {
    alreadyHasOwner ? (
      <>
        <p>{t.accessStep.alreadyCreated}</p>
        <RegisterPasskey next="/panel/primer-ingreso/acceso" text={t.accessStep.addAnother} />
        <p>
          <button type="button" data-continue>{t.common.continue}</button>
        </p>
      </>
    ) : (
      <RegisterPasskey next="/panel/primer-ingreso/nombre" step="acceso" allowKey />
    )
  }
  <p class="error" data-continue-error role="alert"></p>
  <p>
    <small>{t.accessStep.notice}</small>
  </p>
</Panel>

<script>
  import { advance, showError } from "../../../scripts/panel";

  document.querySelector("[data-continue]")?.addEventListener("click", async () => {
    try {
      await advance("acceso");
    } catch (e) {
      showError(document.querySelector("[data-continue-error]"), e);
    }
  });
</script>
