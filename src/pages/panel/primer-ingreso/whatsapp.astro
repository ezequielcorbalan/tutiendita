---
import { env } from "cloudflare:workers";
import { build } from "../../../container";
import { texts } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";
import { COUNTRIES, defaultCountry, splitNumber } from "../../../lib/phone";

const current = await build(env).getPaymentMethod("whatsapp");
const language = Astro.locals.language ?? "es";
const t = texts(language);
const { country, national } = splitNumber(current?.config.number, defaultCountry(language));
const names = new Intl.DisplayNames([language], { type: "region" });
const options = COUNTRIES.map((p) => ({ ...p, name: names.of(p.iso) ?? p.iso }));
---

<Panel title={t.whatsappStep.pageTitle} step={3}>
  <h1>{t.whatsappStep.title}</h1>
  <p>{t.whatsappStep.intro}</p>
  <form data-form>
    <label for="country">{t.whatsappStep.countryLabel}</label>
    <select id="country" name="country" autocomplete="tel-country-code">
      {options.map((p) => <option value={p.iso} selected={p.iso === country}>{p.name} (+{p.code})</option>)}
    </select>
    <label for="number">{t.whatsappStep.label}</label>
    <input id="number" name="number" type="tel" required autocomplete="tel-national" inputmode="tel" placeholder={t.whatsappStep.placeholder} value={national} aria-describedby="number-help" />
    <p id="number-help"><small>{t.whatsappStep.help}</small></p>
    <button type="submit">{t.common.continue}</button>
    <p class="error" data-error role="alert"></p>
  </form>
  <p><a href="/panel/primer-ingreso/nombre">{t.common.back}</a></p>
</Panel>

<script>
  import { buildNumber } from "../../../lib/phone";
  import { advance, element, showError, request } from "../../../scripts/panel";

  const form = element<HTMLFormElement>("[data-form]");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      const data = new FormData(form);
      await request("PUT", "/api/payment-methods/whatsapp", {
        number: buildNumber(String(data.get("country") ?? "AR"), String(data.get("number") ?? "")),
      });
      await advance("whatsapp");
    } catch (e) {
      showError(form.querySelector("[data-error]"), e);
    }
  });
</script>
