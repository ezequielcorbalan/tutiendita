---
import { env } from "cloudflare:workers";
import { armar } from "../../../container";
import { textos } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

const actual = await armar(env).obtenerMedioDePago("whatsapp");
const t = textos(Astro.locals.idioma);
---

<Panel titulo={t.pasoWhatsapp.tituloPagina} paso={3}>
  <h1>{t.pasoWhatsapp.titulo}</h1>
  <p>{t.pasoWhatsapp.intro}</p>
  <form data-formulario>
    <label for="numero">{t.pasoWhatsapp.etiqueta}</label>
    <input id="numero" name="numero" type="tel" required autocomplete="tel" inputmode="tel" placeholder={t.pasoWhatsapp.placeholder} value={actual?.configuracion.numero ?? ""} aria-describedby="numero-ayuda" />
    <p id="numero-ayuda"><small>{t.pasoWhatsapp.ayuda}</small></p>
    <button type="submit">{t.comun.continuar}</button>
    <p class="error" data-error role="alert"></p>
  </form>
  <p><a href="/panel/primer-ingreso/nombre">{t.comun.volver}</a></p>
</Panel>

<script>
  import { avanzar, elemento, mostrarError, pedir } from "../../../scripts/panel";

  const formulario = elemento<HTMLFormElement>("[data-formulario]");
  formulario.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    try {
      await pedir("PUT", "/api/medios-de-pago/whatsapp", {
        numero: String(new FormData(formulario).get("numero") ?? ""),
      });
      await avanzar("whatsapp");
    } catch (e) {
      mostrarError(formulario.querySelector("[data-error]"), e);
    }
  });
</script>
