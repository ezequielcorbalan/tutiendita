---
import DondeEstaElCodigo from "../../components/donde-esta-el-codigo.astro";
import { textos } from "../../i18n";
import Panel from "../../layouts/panel.astro";

const t = textos(Astro.locals.idioma).reclamar;
---

<Panel titulo={t.titulo}>
  <h1>{t.titulo}</h1>
  <p>{t.intro}</p>
  <DondeEstaElCodigo />
  <form data-reclamar>
    <label for="codigo">{t.etiqueta}</label>
    <input id="codigo" name="codigo" required autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />
    <button type="submit">{t.boton}</button>
    <p class="error" data-error role="alert"></p>
  </form>
</Panel>

<script>
  import { elemento, mostrarError, pedir } from "../../scripts/panel";

  const formulario = elemento<HTMLFormElement>("[data-reclamar]");
  formulario.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    const boton = formulario.querySelector("button");
    if (boton) boton.disabled = true;
    try {
      const codigo = String(new FormData(formulario).get("codigo") ?? "");
      await pedir("POST", "/api/acceso/reclamo", { codigo });
      location.assign("/panel/primer-ingreso/acceso");
    } catch (e) {
      mostrarError(formulario.querySelector("[data-error]"), e);
      if (boton) boton.disabled = false;
    }
  });
</script>
