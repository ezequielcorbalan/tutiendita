---
import WhereIsTheCode from "../../components/where-is-the-code.astro";
import { texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";

const t = texts(Astro.locals.language).claim;
---

<Panel title={t.title}>
  <h1>{t.title}</h1>
  <p>{t.intro}</p>
  <WhereIsTheCode />
  <form data-claim>
    <label for="code">{t.label}</label>
    <input id="code" name="code" required autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />
    <button type="submit">{t.button}</button>
    <p class="error" data-error role="alert"></p>
  </form>
</Panel>

<script>
  import { element, showError, request } from "../../scripts/panel";

  const form = element<HTMLFormElement>("[data-claim]");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button");
    if (button) button.disabled = true;
    try {
      const code = String(new FormData(form).get("code") ?? "");
      await request("POST", "/api/access/claim", { code });
      location.assign("/panel/primer-ingreso/acceso");
    } catch (e) {
      showError(form.querySelector("[data-error]"), e);
      if (button) button.disabled = false;
    }
  });
</script>
