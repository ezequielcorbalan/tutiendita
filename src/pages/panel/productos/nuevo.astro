---
import { env } from "cloudflare:workers";
import ProductForm from "../../../components/product-form.astro";
import { build } from "../../../container";
import { texts } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

const container = build(env);
const [store, categories] = await Promise.all([container.getStore(), container.listCategories()]);
const t = texts(Astro.locals.language).newProduct;
---

<Panel title={t.title} section="products">
  <h1>{t.title}</h1>
  <ProductForm currency={store?.currency ?? "ARS"} categories={categories} />
  <p><a href="/panel/productos">{t.back}</a></p>
</Panel>
