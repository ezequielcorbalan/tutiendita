---
import { env } from "cloudflare:workers";
import RegisterPasskey from "../../components/register-passkey.astro";
import { build } from "../../container";
import { LOCALES, texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";

const language = Astro.locals.language ?? "es";
const t = texts(language).access;
const passkeys = await build(env).access.listPasskeys();
const date = (d: Date | null) =>
  d === null ? t.never : d.toLocaleDateString(LOCALES[language], { timeZone: "UTC" });
---

<Panel title={t.title} section="access">
  <h1>{t.title}</h1>
  <h2>{t.yourPasskeys}</h2>
  <ul>
    {
      passkeys.map((p) => (
        <li>
          <strong>{p.name}</strong> — {t.created(date(p.createdAt), date(p.lastUsedAt))}{" "}
          {passkeys.length > 1 && (
            <button type="button" class="secondary" data-delete={p.id}>
              {t.remove}
            </button>
          )}
        </li>
      ))
    }
  </ul>
  <p class="error" data-error role="alert"></p>
  <RegisterPasskey next="/panel/acceso" text={t.add} />

  <h2>{t.codeTitle}</h2>
  <p>{t.codeText}</p>
  <button type="button" data-regenerate>{t.regenerate}</button>
  <div data-new-code hidden></div>
  <p><a href="/panel">{t.backToPanel}</a></p>
</Panel>

<script>
  import { element, showRecoveryCode, showError, request, t } from "../../scripts/panel";

  const error = element("[data-error]");
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-delete]")) {
    button.addEventListener("click", async () => {
      if (!confirm(t().access.confirmDelete)) return;
      try {
        await request("DELETE", `/api/access/passkeys/${encodeURIComponent(button.dataset.delete ?? "")}`);
        location.reload();
      } catch (e) {
        showError(error, e);
      }
    });
  }
  const regenerate = element<HTMLButtonElement>("[data-regenerate]");
  regenerate.addEventListener("click", async () => {
    try {
      const { recoveryCode } = await request<{ recoveryCode: string }>(
        "POST",
        "/api/access/recovery-code",
        {},
      );
      regenerate.hidden = true;
      showRecoveryCode(element("[data-new-code]"), recoveryCode, () => location.reload(), t().access.ready);
    } catch (e) {
      showError(error, e);
    }
  });
</script>
