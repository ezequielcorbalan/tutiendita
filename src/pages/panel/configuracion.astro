---
// Public URL stays in Spanish (/panel/configuracion), like the rest of the panel's URLs.
import { env } from "cloudflare:workers";
import { BRAND_COLORS, MAX_STORE_DESCRIPTION_LENGTH, MAX_STORE_NAME_LENGTH } from "../../packages/core/index";
import LanguageSelector from "../../components/language-selector.astro";
import { build } from "../../container";
import { texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";

const container = build(env);
const [store, color, domain, photos] = await Promise.all([
  container.getStore(),
  container.identity.color(),
  container.domain.status(),
  container.photos.status(),
]);
const all = texts(Astro.locals.language);
const t = all.settings;
const n = all.navPanel;
---

<Panel title={t.title} section="settings">
  <h1>{t.title}</h1>

  <nav class="settings-links" aria-label={t.linksLabel}>
    <a class="card settings-links__item" href="/panel/acceso">
      <svg class="settings-links__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M7 14a4 4 0 1 1 3.9-5H21v3h-2v3h-3v-3h-5.1A4 4 0 0 1 7 14z" />
      </svg>
      <span class="settings-links__text">
        <strong class="settings-links__title">{n.access}</strong>
        {t.accessText}
      </span>
    </a>
    <a class="card settings-links__item" href="/panel/actualizaciones">
      <svg class="settings-links__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" />
      </svg>
      <span class="settings-links__text">
        <strong class="settings-links__title">{n.updates}</strong>
        {t.updatesText}
      </span>
    </a>
  </nav>

  <section aria-labelledby="identity">
    <h2 id="identity">{t.identityTitle}</h2>
    <form data-identity enctype="multipart/form-data">
      <label for="store-name">{t.identityName}</label>
      <input
        id="store-name"
        name="name"
        type="text"
        value={store?.name ?? ""}
        maxlength={MAX_STORE_NAME_LENGTH}
        autocomplete="organization"
        required
      />
      <label for="store-tagline">{t.identityTagline}</label>
      <textarea
        id="store-tagline"
        name="description"
        rows="2"
        maxlength={MAX_STORE_DESCRIPTION_LENGTH}
        aria-describedby="store-tagline-help">{store?.description ?? ""}</textarea
      >
      <p id="store-tagline-help"><small>{t.identityTaglineHelp}</small></p>
      <label for="store-logo">{t.identityLogo}</label>
      {store?.logoKey && <img class="identity-logo" src={`/img/${store.logoKey}`} alt="" width="80" height="80" />}
      <input
        id="store-logo"
        name="logo"
        type="file"
        accept="image/jpeg,image/png,image/webp"
        aria-describedby="store-logo-help"
      />
      <p id="store-logo-help"><small>{t.identityLogoHelp}</small></p>
      {
        store?.logoKey && (
          <label>
            <input type="checkbox" name="remove_logo" value="true" /> {t.identityRemoveLogo}
          </label>
        )
      }
      <fieldset class="swatches" aria-describedby="store-color-help">
        <legend>{t.identityColor}</legend>
        {
          BRAND_COLORS.map((c) => (
            <label class="swatch">
              <input class="swatch__input" type="radio" name="color" value={c.id} checked={c.id === color} />
              <span class="swatch__dot" style={`--swatch: ${c.light.brand}`} aria-hidden="true" />
              {t.identityColorNames[c.id]}
            </label>
          ))
        }
      </fieldset>
      <p id="store-color-help"><small>{t.identityColorHelp}</small></p>
      <button type="submit">{t.identitySave}</button>
      <p class="error" data-error role="alert"></p>
    </form>
  </section>

  <section aria-labelledby="domain">
    <h2 id="domain">{t.domainTitle}</h2>
    {
      domain.status === "active" ? (
        <>
          <p>
            {t.active} <a href={`https://${domain.hostname}`}>{domain.hostname}</a>.
          </p>
          <p>{t.activeHelp}</p>
        </>
      ) : domain.status === "connecting" ? (
        <>
          <p role="status">{t.connecting(domain.hostname)}</p>
          <p>{t.connectingHelp}</p>
          <p>
            <a class="button" href="/panel/configuracion">
              {t.checkAgain}
            </a>
          </p>
        </>
      ) : domain.status === "github-needed" ? (
        <>
          <p>{t.domainIntro}</p>
          <p>{t.githubNeeded}</p>
          <p>
            <a class="button" href="/panel/actualizaciones">
              {t.goToUpdates}
            </a>
          </p>
        </>
      ) : (
        <>
          <p>{t.domainIntro}</p>
          <form data-domain-check novalidate>
            <label for="hostname">{t.domainLabel}</label>
            <input
              id="hostname"
              name="hostname"
              type="text"
              inputmode="url"
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
              placeholder="tienda.tunegocio.com.ar"
              aria-describedby="hostname-hint"
              required
            />
            <p id="hostname-hint"><small>{t.domainHint}</small></p>
            <button type="submit" data-checking={t.checking}>
              {t.check}
            </button>
          </form>
          <div class="domain-result" data-domain-result aria-live="polite">
            <div data-ready hidden>
              <p data-ready-text />
              <button type="button" data-connect />
            </div>
            <div data-not-delegated hidden>
              <h3>{t.notDelegatedTitle}</h3>
              <ol>
                {t.notDelegatedSteps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
              <p data-nameservers />
            </div>
            <p data-in-use hidden />
          </div>
        </>
      )
    }
    {
      (domain.status === "active" || domain.status === "connecting") && (
        <p>
          <button type="button" class="secondary" data-disconnect data-confirm={t.confirmDisconnect}>
            {t.disconnect}
          </button>
        </p>
      )
    }
    <p class="error" data-domain-error role="alert"></p>
  </section>

  <section
    id="photos"
    aria-labelledby="photos-title"
    data-photos-polling={photos.mode === "activating" && !photos.failed ? "" : undefined}
  >
    <h2 id="photos-title">{t.photosTitle}</h2>
    {
      photos.mode === "professional" ? (
        <>
          <p>
            <strong>{t.photosProTitle}</strong> · {t.photosActive}
          </p>
          <p>{t.photosProHelp}</p>
        </>
      ) : photos.mode === "activating" ? (
        photos.failed ? (
          <>
            <p>
              {t.photosFailed} <code>{photos.bucketName}</code>.
            </p>
            <p>
              <a href="https://dash.cloudflare.com/?to=/:account/workers-and-pages" target="_blank" rel="noopener">
                {t.photosDeployLink}
              </a>
            </p>
            <p>{t.photosMeanwhile}</p>
            <p>
              <button type="button" class="secondary" data-revert>
                {t.photosRevert}
              </button>
            </p>
          </>
        ) : (
          <p role="status">{t.photosActivating}</p>
        )
      ) : (
        <>
          <p>
            <strong>{t.photosBasicTitle}</strong> · {t.photosUsed(photos.used, photos.max)}
          </p>
          <p>{t.photosBasicHelp}</p>
          <h3>{t.photosProTitle}</h3>
          <p set:html={t.photosProIntroHtml} />
          <ol>
            <li>
              {t.photosStep1} <code data-bucket>{photos.bucketName}</code>
              <p class="actions">
                <button type="button" class="secondary" data-copy data-copied={t.photosCopied}>
                  <span aria-live="polite">{t.photosCopy}</span>
                </button>
                <a class="button secondary" href="https://dash.cloudflare.com/?to=/:account/r2" target="_blank" rel="noopener">
                  {t.photosOpenR2}
                </a>
              </p>
            </li>
            {photos.github && (
              <>
                <li>
                  <label>
                    <input type="checkbox" data-r2-ready /> {t.photosReady}
                  </label>
                </li>
                <li>
                  <button type="button" data-enable disabled>
                    {t.photosEnable}
                  </button>
                </li>
              </>
            )}
          </ol>
          {photos.github ? (
            <p>
              <small>{t.photosGithubNote}</small>
            </p>
          ) : (
            <>
              <p>{t.photosGithubNote}</p>
              <p>
                <a class="button" href="/panel/actualizaciones">
                  {t.goToUpdates}
                </a>
              </p>
            </>
          )}
        </>
      )
    }
    <p class="error" data-photos-error role="alert"></p>
  </section>

  <section aria-labelledby="language">
    <h2 id="language">{t.languageTitle}</h2>
    <form data-language>
      <LanguageSelector current={store?.language ?? "es"} />
      <button type="submit">{t.saveLanguage}</button>
      <p class="error" data-error role="alert"></p>
    </form>
  </section>

  <section aria-labelledby="heartbeat">
    <h2 id="heartbeat">{t.heartbeatTitle}</h2>
    <p id="heartbeat-intro">{t.heartbeatIntro}</p>
    <form data-heartbeat>
      <label>
        <input
          type="checkbox"
          name="enabled"
          checked={store?.heartbeatEnabled ?? true}
          aria-describedby="heartbeat-intro"
        />
        {t.heartbeatLabel}
      </label>
      <button type="submit">{t.saveHeartbeat}</button>
      <p class="error" data-error role="alert"></p>
    </form>
  </section>
</Panel>

<!-- is:global: a scoped style would add data-astro-cid-* to every element of the page. -->
<style is:global>
  /* Below the sticky panel bar when the page is opened at #photos. */
  #photos {
    scroll-margin-top: 6rem;
  }

  /* The bucket name stays on one line when it fits; a long one still wraps instead of overflowing. */
  [data-bucket] {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .identity-logo {
    display: block;
    width: 5rem;
    height: 5rem;
    margin: 0.5rem 0;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-2);
  }

  /* Brand colour swatches: the native radio stays for keyboard and screen readers; the dot shows the colour,
     the chosen one has a ring and bold text (not colour alone). */
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.25rem 1rem;
    margin-top: 1rem;
  }

  .swatches .swatch {
    margin-top: 0;
    cursor: pointer;
  }

  .swatches .swatch:has(.swatch__input:checked) {
    font-weight: 700;
  }

  .swatches .swatch__input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .swatch__dot {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--swatch);
    outline: 3px solid transparent;
    outline-offset: 3px;
  }

  .swatches .swatch__input:checked + .swatch__dot {
    outline-color: var(--text);
  }

  .swatches .swatch__input:focus-visible + .swatch__dot {
    box-shadow: 0 0 0 3px var(--background), 0 0 0 6px var(--focus);
  }
</style>

<script>
  import { element, request, showError, t } from "../../scripts/panel";

  type Check = { hostname: string; zone: string | null; delegated: boolean; nameservers: string[]; records: string[] };

  /** Saves the form's setting and renders the page again (in the new language, with the new state). */
  const saveAndReload = (selector: string, path: string, body: (data: FormData) => unknown) => {
    const form = element<HTMLFormElement>(selector);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      try {
        await request("PUT", path, body(new FormData(form)));
        location.reload();
      } catch (e) {
        showError(form.querySelector("[data-error]"), e);
      }
    });
  };
  saveAndReload("[data-identity]", "/api/store/identity", (d) => {
    // A file input left empty still adds a 0-byte file: that means "keep the logo as it is".
    const logo = d.get("logo");
    if (logo instanceof File && logo.size === 0) d.delete("logo");
    return d;
  });
  saveAndReload("[data-language]", "/api/store/language", (d) => ({ language: String(d.get("language") ?? "") }));
  saveAndReload("[data-heartbeat]", "/api/store/heartbeat", (d) => ({ enabled: d.has("enabled") }));

  const error = document.querySelector("[data-domain-error]");
  const show = (selector: string, visible: boolean) =>
    document.querySelector<HTMLElement>(selector)?.toggleAttribute("hidden", !visible);

  const check = document.querySelector<HTMLFormElement>("[data-domain-check]");
  const connect = document.querySelector<HTMLButtonElement>("[data-connect]");
  check?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = check.querySelector<HTMLButtonElement>("button");
    const label = button?.textContent ?? "";
    if (button) {
      button.disabled = true;
      button.textContent = button.dataset.checking ?? label;
    }
    if (error) error.textContent = "";
    for (const s of ["[data-ready]", "[data-not-delegated]", "[data-in-use]"]) show(s, false);
    try {
      const r = await request<Check>("POST", "/api/domain/check", {
        hostname: String(new FormData(check).get("hostname") ?? ""),
      });
      const s = t().settings;
      if (!r.delegated) {
        element("[data-nameservers]").textContent =
          r.nameservers.length > 0 ? s.currentNameservers(r.nameservers.join(", ")) : "";
        show("[data-not-delegated]", true);
      } else if (r.records.length > 0) {
        element("[data-in-use]").textContent = s.inUse(r.hostname, r.records.join(", "));
        show("[data-in-use]", true);
      } else if (connect) {
        element("[data-ready-text]").textContent = s.ready(r.zone ?? r.hostname, r.hostname);
        connect.textContent = s.connect(r.hostname);
        connect.dataset.hostname = r.hostname;
        show("[data-ready]", true);
        connect.focus();
      }
    } catch (e) {
      showError(error, e);
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = label;
      }
    }
  });

  connect?.addEventListener("click", async () => {
    connect.disabled = true;
    try {
      await request("POST", "/api/domain/connect", { hostname: connect.dataset.hostname ?? "" });
      location.reload();
    } catch (e) {
      connect.disabled = false;
      showError(error, e);
    }
  });

  const disconnect = document.querySelector<HTMLButtonElement>("[data-disconnect]");
  disconnect?.addEventListener("click", async () => {
    if (!confirm(disconnect.dataset.confirm ?? "")) return;
    disconnect.disabled = true;
    try {
      await request("POST", "/api/domain/disconnect");
      location.reload();
    } catch (e) {
      disconnect.disabled = false;
      showError(error, e);
    }
  });

  const photosError = document.querySelector("[data-photos-error]");
  const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
  copy?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(element("[data-bucket]").textContent ?? "");
      const label = element("[data-copy] [aria-live]");
      const original = label.textContent;
      label.textContent = copy.dataset.copied ?? "";
      setTimeout(() => {
        label.textContent = original;
      }, 2000);
    } catch (e) {
      showError(photosError, e);
    }
  });

  const enable = document.querySelector<HTMLButtonElement>("[data-enable]");
  const ready = document.querySelector<HTMLInputElement>("[data-r2-ready]");
  ready?.addEventListener("change", () => {
    if (enable) enable.disabled = !ready.checked;
  });

  // Enable and revert POST, then the page is rendered again with the new state.
  for (const [button, url] of [
    [enable, "/api/photos/enable"],
    [document.querySelector<HTMLButtonElement>("[data-revert]"), "/api/photos/revert"],
  ] as const) {
    button?.addEventListener("click", async () => {
      button.disabled = true;
      if (photosError) photosError.textContent = "";
      try {
        await request("POST", url);
        location.reload();
      } catch (e) {
        button.disabled = false;
        showError(photosError, e);
      }
    });
  }

  // While Cloudflare redeploys with the bucket: check every 20 s and reload when it's done or has failed.
  if (document.querySelector("[data-photos-polling]")) {
    setInterval(async () => {
      try {
        const s = await request<{ mode: string; failed?: boolean }>("GET", "/api/photos/status");
        if (s.mode !== "activating" || s.failed) location.reload();
      } catch {
        // A network blip: try again on the next tick.
      }
    }, 20_000);
  }
</script>
