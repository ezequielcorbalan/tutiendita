---
import { env } from "cloudflare:workers";
import LanguageSelector from "../../components/language-selector.astro";
import { build } from "../../container";
import { texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";

const container = build(env);
const [store, all] = await Promise.all([container.getStore(), container.listAllProducts()]);
// Product status is stored in D1: the literals stay in Spanish.
const published = all.filter((p) => p.status === "publicado").length;
const t = texts(Astro.locals.language).panelHome;
---

<Panel title={t.title} section="home">
  <section class="dashboard__greeting" aria-labelledby="greeting">
    <p class="label">{store?.name ?? t.yourStore}</p>
    <h1 id="greeting">{t.selling}</h1>
    <p>
      <strong>{store?.name ?? t.yourStore}</strong> {t.open} <a href="/">{t.seeIt}</a>.
    </p>
  </section>

  <section aria-labelledby="summary">
    <h2 id="summary">{t.summary}</h2>
    <ul class="dashboard__figures">
      <li class="card">
        <span class="dashboard__number">{published}</span>
        <span>{t.publishedCount}</span>
      </li>
      <li class="card">
        <span class="dashboard__number">{all.length - published}</span>
        <span>{t.unpublishedCount}</span>
      </li>
    </ul>
    {all.length === 0 && <p>{t.noProducts}</p>}
    <p><a class="button secondary" href="/panel/productos">{t.viewProducts}</a></p>
  </section>

  <section aria-labelledby="insights">
    <h2 id="insights">{t.insightsTitle}</h2>
    <p>{t.insightsIntro}</p>
    <ul class="dashboard__insights">
      {
        t.insights.map((i, n) => (
          <li class="card card--coming-soon">
            <span class="badge">{t.comingSoon}</span>
            <h3>{i.title}</h3>
            <p>{i.text}</p>
            <div class="dashboard__chart" aria-hidden="true">
              {[40, 65, 50, 80, 60, 90, 70].map((height, k) => (
                <span style={`--height: ${(height + n * 7 + k * 3) % 100}%`} />
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="settings">
    <h2 id="settings">{t.languageTitle}</h2>
    <form data-language>
      <LanguageSelector current={store?.language ?? "es"} />
      <button type="submit">{t.saveLanguage}</button>
      <p class="error" data-error role="alert"></p>
    </form>
  </section>
</Panel>

<script>
  import { element, showError, request } from "../../scripts/panel";

  const form = element<HTMLFormElement>("[data-language]");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      await request("PUT", "/api/store/language", { language: String(new FormData(form).get("language") ?? "") });
      // The page is rendered again in the new language.
      location.reload();
    } catch (e) {
      showError(form.querySelector("[data-error]"), e);
    }
  });
</script>
