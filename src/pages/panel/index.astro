---
import { env } from "cloudflare:workers";
import SelectorDeIdioma from "../../components/selector-de-idioma.astro";
import { armar } from "../../container";
import { textos } from "../../i18n";
import Panel from "../../layouts/panel.astro";

const contenedor = armar(env);
const [tienda, todos] = await Promise.all([contenedor.obtenerTienda(), contenedor.listarTodosLosProductos()]);
const publicados = todos.filter((p) => p.estado === "publicado").length;
const t = textos(Astro.locals.idioma).inicioPanel;
---

<Panel titulo={t.titulo} seccion="inicio">
  <section class="tablero__saludo" aria-labelledby="saludo">
    <p class="etiqueta">{tienda?.nombre ?? t.tuTienda}</p>
    <h1 id="saludo">{t.vendiendo}</h1>
    <p>
      <strong>{tienda?.nombre ?? t.tuTienda}</strong> {t.abierta} <a href="/">{t.mirala}</a>.
    </p>
  </section>

  <section aria-labelledby="resumen">
    <h2 id="resumen">{t.resumen}</h2>
    <ul class="tablero__cifras">
      <li class="tarjeta">
        <span class="tablero__numero">{publicados}</span>
        <span>{t.cifraPublicados}</span>
      </li>
      <li class="tarjeta">
        <span class="tablero__numero">{todos.length - publicados}</span>
        <span>{t.cifraSinPublicar}</span>
      </li>
    </ul>
    {todos.length === 0 && <p>{t.sinProductos}</p>}
    <p><a class="boton secundario" href="/panel/productos">{t.verProductos}</a></p>
  </section>

  <section aria-labelledby="insights">
    <h2 id="insights">{t.insightsTitulo}</h2>
    <p>{t.insightsIntro}</p>
    <ul class="tablero__insights">
      {
        t.insights.map((i, n) => (
          <li class="tarjeta tarjeta--proximamente">
            <span class="insignia">{t.proximamente}</span>
            <h3>{i.titulo}</h3>
            <p>{i.texto}</p>
            <div class="tablero__grafico" aria-hidden="true">
              {[40, 65, 50, 80, 60, 90, 70].map((alto, k) => (
                <span style={`--alto: ${(alto + n * 7 + k * 3) % 100}%`} />
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="configuracion">
    <h2 id="configuracion">{t.idiomaTitulo}</h2>
    <form data-idioma>
      <SelectorDeIdioma actual={tienda?.idioma ?? "es"} />
      <button type="submit">{t.guardarIdioma}</button>
      <p class="error" data-error role="alert"></p>
    </form>
  </section>
</Panel>

<script>
  import { elemento, mostrarError, pedir } from "../../scripts/panel";

  const formulario = elemento<HTMLFormElement>("[data-idioma]");
  formulario.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    try {
      await pedir("PUT", "/api/tienda/idioma", { idioma: String(new FormData(formulario).get("idioma") ?? "") });
      // La página se vuelve a pintar en el idioma nuevo.
      location.reload();
    } catch (e) {
      mostrarError(formulario.querySelector("[data-error]"), e);
    }
  });
</script>
