---
import { env } from "cloudflare:workers";
import { build } from "../../container";
import { texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";

const container = build(env);
// shortcut: loads every order to count them; add a COUNT query when stores have hundreds of sales
const [store, all, orders] = await Promise.all([
  container.getStore(),
  container.listAllProducts(),
  container.orders.list(),
]);
// Product status is stored in D1: the literals stay in Spanish.
const pending = orders.filter((o) => o.status === "nuevo" || o.status === "contactado").length;
const published = all.filter((p) => p.status === "publicado").length;
const t = texts(Astro.locals.language).panelHome;
---

<Panel title={t.title} section="home">
  <section class="dashboard__greeting" aria-labelledby="greeting">
    <p class="label">{store?.name ?? t.yourStore}</p>
    <h1 id="greeting">{t.selling}</h1>
    <p>
      <strong>{store?.name ?? t.yourStore}</strong> {t.open} <a href="/">{t.seeIt}</a>.
    </p>
  </section>

  <!-- Filled after load from /panel/actualizaciones/aviso: only security or bugfix updates. -->
  <div data-update-alert></div>

  <section aria-labelledby="summary">
    <h2 id="summary">{t.summary}</h2>
    <ul class="dashboard__figures">
      <li class="card">
        <span class="dashboard__number">{published}</span>
        <span>{t.publishedCount}</span>
      </li>
      <li class="card">
        <span class="dashboard__number">{all.length - published}</span>
        <span>{t.unpublishedCount}</span>
      </li>
      <li class="card">
        <span class="dashboard__number">{pending}</span>
        <span>{t.pendingSales}</span>
      </li>
    </ul>
    {all.length === 0 && <p>{t.noProducts}</p>}
    <p>
      <a class="button secondary" href="/panel/productos">{t.viewProducts}</a>
      <a class="button secondary" href="/panel/ventas">{t.viewSales}</a>
    </p>
  </section>

  <section aria-labelledby="insights">
    <h2 id="insights">{t.insightsTitle}</h2>
    <p>{t.insightsIntro}</p>
    <div class="card card--coming-soon">
      <span class="badge">{t.comingSoon}</span>
      <ul class="dashboard__insights">
        {
          t.insights.map((i) => (
            <li>
              <strong>{i.title}</strong> {i.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Panel>

<script>
  import { element } from "../../scripts/panel";

  // Our own same-origin fragment (server-rendered, escaped by Astro). If it fails, the home just shows no alert.
  fetch("/panel/actualizaciones/aviso", { credentials: "same-origin" })
    .then((r) => (r.ok ? r.text() : ""))
    .then((html) => {
      element("[data-update-alert]").innerHTML = html;
    })
    .catch(() => {});
</script>
