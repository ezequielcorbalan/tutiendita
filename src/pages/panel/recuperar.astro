---
import RegisterPasskey from "../../components/register-passkey.astro";
import { texts } from "../../i18n";
import Panel from "../../layouts/panel.astro";

// No session: asks for the recovery code. With the recovery session: create the new passkey.
const inRecovery = Astro.locals.panel?.session === "recuperacion";
const t = texts(Astro.locals.language);
---

<Panel title={t.recover.pageTitle}>
  {
    inRecovery ? (
      <>
        <h1>{t.recover.newTitle}</h1>
        <p>{t.recover.newText}</p>
        <RegisterPasskey next="/panel/acceso" text={t.recover.newButton} />
      </>
    ) : (
      <>
        <h1>{t.recover.title}</h1>
        <p>{t.recover.intro}</p>
        <p data-unsupported hidden>{t.recover.unsupported}</p>
        <form data-recover>
          <label for="code">{t.recover.label}</label>
          <input id="code" name="code" required autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />
          <button type="submit">{t.recover.button}</button>
          <p class="error" data-error role="alert" />
        </form>
        <p>
          <small>{t.recover.emergency}</small>
        </p>
        <p><a href="/panel/ingresar">{t.common.back}</a></p>
      </>
    )
  }
</Panel>

<script>
  import { browserSupportsWebAuthn, showError, request } from "../../scripts/panel";

  const form = document.querySelector<HTMLFormElement>("[data-recover]");
  // Without WebAuthn there's no point signing in with the code: the new passkey couldn't be created.
  if (form && !browserSupportsWebAuthn()) {
    document.querySelector<HTMLElement>("[data-unsupported]")?.removeAttribute("hidden");
    for (const field of form.querySelectorAll<HTMLInputElement | HTMLButtonElement>("input, button")) {
      field.disabled = true;
    }
  }
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      await request("POST", "/api/access/recovery", { code: String(new FormData(form).get("code") ?? "") });
      location.reload();
    } catch (e) {
      showError(form.querySelector("[data-error]"), e);
    }
  });
</script>
