---
// Vuelta de GitHub después de crear la app desde el manifiesto: canjea el `code` y manda a instalarla.
import { env } from "cloudflare:workers";
import { armar } from "../../../container";
import { textos } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";
import { nombreDeCookie } from "../../../lib/cookies";
import { COOKIE_ESTADO_GITHUB } from "../../../lib/github-manifiesto";

const t = textos(Astro.locals.idioma);
const cookie = nombreDeCookie(COOKIE_ESTADO_GITHUB, Astro.url);
const esperado = Astro.cookies.get(cookie)?.value;
const codigo = Astro.url.searchParams.get("code");
const estado = Astro.url.searchParams.get("state");
Astro.cookies.delete(cookie, { path: "/" });

let error: string = t.actualizaciones.conexionFallida;
if (esperado && codigo && estado === esperado) {
  const r = await armar(env).actualizaciones.conectar(codigo);
  if (r.ok) return Astro.redirect(`https://github.com/apps/${r.valor.slug}/installations/new`);
  error = t.errores.api[r.error.codigo];
}
---

<Panel titulo={t.actualizaciones.titulo} seccion="actualizaciones">
  <h1>{t.actualizaciones.titulo}</h1>
  <p class="error" role="alert">{error}</p>
  <p><a href="/panel/actualizaciones">{t.actualizaciones.volver}</a></p>
</Panel>
