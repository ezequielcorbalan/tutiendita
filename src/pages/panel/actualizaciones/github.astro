---
// Return from GitHub after creating the app from the manifest: exchanges the `code` and sends to install it.
import { env } from "cloudflare:workers";
import { build } from "../../../container";
import { texts } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";
import { cookieName } from "../../../lib/cookies";
import { GITHUB_STATE_COOKIE } from "../../../lib/github-manifest";

const t = texts(Astro.locals.language);
const cookie = cookieName(GITHUB_STATE_COOKIE, Astro.url);
const expected = Astro.cookies.get(cookie)?.value;
const code = Astro.url.searchParams.get("code");
const status = Astro.url.searchParams.get("state");
Astro.cookies.delete(cookie, { path: "/" });

let error: string = t.updates.failedConnection;
if (expected && code && status === expected) {
  const r = await build(env).updates.connect(code);
  if (r.ok) return Astro.redirect(`https://github.com/apps/${r.value.slug}/installations/new`);
  error = t.errors.api[r.error.code];
}
---

<Panel title={t.updates.title} section="updates">
  <h1>{t.updates.title}</h1>
  <p class="error" role="alert">{error}</p>
  <p><a href="/panel/actualizaciones">{t.updates.back}</a></p>
</Panel>
