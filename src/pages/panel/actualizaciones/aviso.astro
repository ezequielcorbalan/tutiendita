---
/**
 * HTML fragment the panel home loads after rendering: asking GitHub (or, on the hosted plan, the hosting
 * service) takes a while and the home shouldn't wait. Empty when there is no security or bugfix update, or
 * nobody answers.
 */
import { env } from "cloudflare:workers";
import UpdateAlert from "../../../components/update-alert.astro";
import { build } from "../../../container";
import { STORE_VERSION } from "../../../version";

export const partial = true;

const updates = build(env).updates;
const status = await (updates.hosted ? updates.hosted.status(STORE_VERSION) : updates.status(STORE_VERSION));
const update = status.ok && status.value.status === "update-available" ? status.value : null;
---

{update && <UpdateAlert kind={update.kind} version={update.newVersion} link />}
