---
// Return from GitHub after installing the app: saves the installation if it only sees the store's repo.
import { env } from "cloudflare:workers";
import { build } from "../../../container";
import { texts } from "../../../i18n";
import Panel from "../../../layouts/panel.astro";

const t = texts(Astro.locals.language);
const id = Number(Astro.url.searchParams.get("installation_id"));

let error: string = t.updates.failedConnection;
let reconfigure: string | null = null;
if (Number.isSafeInteger(id) && id > 0) {
  const r = await build(env).updates.registerInstallation(id);
  if (r.ok) return Astro.redirect("/panel/actualizaciones");
  error = t.errors.api[r.error.code];
  if (r.error.code === "GITHUB_MULTIPLE_REPOSITORIES")
    reconfigure = `https://github.com/settings/installations/${id}`;
}
---

<Panel title={t.updates.title} section="updates">
  <h1>{t.updates.title}</h1>
  <p class="error" role="alert">{error}</p>
  {reconfigure && <p><a class="button" href={reconfigure}>{t.updates.install}</a></p>}
  <p><a href="/panel/actualizaciones">{t.updates.back}</a></p>
</Panel>
