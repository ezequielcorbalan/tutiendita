---
import { env } from "cloudflare:workers";
import Catalog from "../../components/catalog.astro";
import { texts } from "../../i18n";
import Store from "../../layouts/store.astro";
import { homeData } from "../../lib/pages";

const t = texts(Astro.locals.language);
const data = await homeData(env, Astro.url.origin, Astro.locals.language, Astro.params.slug ?? "");
const found = data.status === "ready" && data.currentCategory !== null;
if (!found) Astro.response.status = 404;
---

{
  data.status === "ready" && data.currentCategory ? (
    <Store title={data.currentCategory.name} description={t.store.productsOf(data.name)}>
      <script slot="head" type="application/ld+json" is:inline set:html={data.jsonLd} />
      <Catalog data={data} />
    </Store>
  ) : (
    <Store title={t.store.categoryNotFoundTitle}>
      <h1>{t.store.categoryNotFoundTitle}</h1>
      <p>{t.store.categoryNotFound} <a href="/">{t.common.backToStore}</a></p>
    </Store>
  )
}
