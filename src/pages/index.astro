---
import { env } from "cloudflare:workers";
import Catalog from "../components/catalog.astro";
import FirstBoot from "../components/first-boot.astro";
import Preparing from "../components/preparing.astro";
import { texts } from "../i18n";
import Store from "../layouts/store.astro";
import { homeData } from "../lib/pages";

const t = texts(Astro.locals.language).store;
const data = await homeData(env, Astro.url.origin, Astro.locals.language);
---

{
  data.status === "unclaimed" ? (
    <FirstBoot />
  ) : data.status === "setting-up" ? (
    <Preparing />
  ) : (
    <Store description={t.productsOf(data.name)}>
      <script slot="head" type="application/ld+json" is:inline set:html={data.jsonLd} />
      <Catalog data={data} />
    </Store>
  )
}
