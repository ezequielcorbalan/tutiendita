---
import { env } from "cloudflare:workers";
import { texts } from "../../i18n";
import Store from "../../layouts/store.astro";
import { productData } from "../../lib/pages";

const t = texts(Astro.locals.language);
const data = await productData(env, Astro.params.slug ?? "", Astro.url.origin, Astro.locals.language);
if (!data.found) Astro.response.status = 404;
---

{
  data.found ? (
    <Store title={data.product.name} description={data.product.description}>
      <script slot="head" type="application/ld+json" is:inline set:html={data.jsonLd} />
      <p><a href="/">← {t.common.backToStore}</a></p>
      <h1>{data.product.name}</h1>
      {data.product.images.map((img) => (
        <img src={img.url} alt={data.product.name} width="480" height="480" />
      ))}
      <p class="price">{data.product.priceText}</p>
      {data.product.description && <p>{data.product.description}</p>}
    </Store>
  ) : (
    <Store title={t.store.productNotFoundTitle}>
      <h1>{t.store.productNotFoundTitle}</h1>
      <p>{t.store.productNotFound} <a href="/">{t.common.backToStore}</a></p>
    </Store>
  )
}
