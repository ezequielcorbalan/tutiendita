---
import { env } from "cloudflare:workers";
import HowToBuy from "../../components/how-to-buy.astro";
import ProductCard from "../../components/product-card.astro";
import { LOCALES, texts } from "../../i18n";
import Store from "../../layouts/store.astro";
import { productUrl } from "../../lib/json-ld";
import { formatPrice, productData } from "../../lib/pages";
import { MAX_QUANTITY } from "../../scripts/cart";

const t = texts(Astro.locals.language);
const data = await productData(env, Astro.params.slug ?? "", Astro.url.origin, Astro.locals.language);
if (!data.found) Astro.response.status = 404;
const language = Astro.locals.language ?? "es";
const v = t.variants;
/** "Chocolate (+ $500)", or just the label when it doesn't change the price. */
const valueText = (label: string, delta: number, currency: string) =>
  delta === 0
    ? label
    : `${label} (${delta > 0 ? "+" : "−"} ${formatPrice(Math.abs(delta), currency, language)})`;
/** "Consultar por WhatsApp" opens a chat with the product's name and URL already written. */
const consultHref = (number: string, name: string, slug: string) =>
  `https://wa.me/${number}?text=${encodeURIComponent(t.store.consultMessage(name, productUrl(slug, Astro.url.origin)))}`;
---

{
  data.found ? (
    <Store
      title={data.product.name}
      description={data.product.description || undefined}
      image={data.product.images[0] && new URL(data.product.images[0].url, Astro.url.origin).href}
    >
      <script slot="head" type="application/ld+json" is:inline set:html={data.jsonLd} />
      <nav class="breadcrumb" aria-label={t.store.breadcrumb}>
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a class="breadcrumb__link" href="/">{t.store.home}</a>
          </li>
          {data.category && (
            <li class="breadcrumb__item">
              <svg class="breadcrumb__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M9 6l6 6-6 6" />
              </svg>
              <a class="breadcrumb__link" href={`/c/${data.category.slug}`}>{data.category.name}</a>
            </li>
          )}
          <li class="breadcrumb__item" aria-current="page">
            <svg class="breadcrumb__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 6l6 6-6 6" />
            </svg>
            {data.product.name}
          </li>
        </ol>
      </nav>
      <div class="product-page">
        <div class="product-page__gallery" data-gallery>
          {data.product.images[0] && (
            <img
              src={data.product.images[0].url}
              alt={data.product.name}
              width="480"
              height="480"
              data-gallery-main
            />
          )}
          {data.product.images.length > 1 && (
            <>
              {/* Without JavaScript the thumbnails stay hidden and every photo shows as a plain image. */}
              <noscript>
                {data.product.images.slice(1).map((img) => (
                  <img src={img.url} alt={data.product.name} width="480" height="480" />
                ))}
              </noscript>
              <div class="product-page__thumbs" data-thumbs hidden>
                {data.product.images.map((img, i, all) => (
                  <button
                    type="button"
                    data-thumb={img.url}
                    aria-label={t.store.viewPhoto(i + 1, all.length)}
                    aria-current={i === 0 ? "true" : undefined}
                  >
                    <img src={img.url} alt="" width="64" height="64" loading="lazy" />
                  </button>
                ))}
              </div>
            </>
          )}
        </div>
        <div class="product-page__info">
          {data.category && <p class="label">{data.category.name}</p>}
          <h1>{data.product.name}</h1>
          <p class="price" data-price>{data.product.priceText}</p>
          {data.product.options.length > 0 && (
            <div class="variant-picker" data-variants>
              {data.product.options.map((o) => (
                <fieldset class="variant-picker__group" data-option-id={o.id} data-option-name={o.name}>
                  <legend class="variant-picker__legend">{o.name}</legend>
                  <div class="variant-picker__pills">
                    {o.values.map((val) => (
                      <label class="pill">
                        <input
                          class="pill__input"
                          type="radio"
                          name={`option-${o.id}`}
                          value={val.id}
                          data-delta={val.priceDelta}
                          data-label={val.label}
                          data-image={val.imageUrl ?? ""}
                          required
                        />
                        {valueText(val.label, val.priceDelta, data.product.price.currency)}
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>
          )}
          <p class="error" data-choose-all hidden role="alert">{v.chooseAll}</p>
          <div class="product-page__buy">
            <div class="stepper">
              <button type="button" class="stepper__button" data-step="-1" aria-label={t.cart.oneLess}>
                −
              </button>
              <input
                class="stepper__input"
                type="number"
                min="1"
                max={MAX_QUANTITY}
                value="1"
                inputmode="numeric"
                aria-label={t.cart.quantity}
                data-quantity
              />
              <button type="button" class="stepper__button" data-step="1" aria-label={t.cart.oneMore}>
                +
              </button>
            </div>
            <button
              type="button"
              class="product-page__add"
              data-add-to-cart
              data-product-id={data.product.id}
              data-slug={data.product.slug}
              data-name={data.product.name}
              data-amount={data.product.price.amount}
              data-currency={data.product.price.currency}
              data-image={data.product.images[0]?.url ?? ""}
              data-locale={LOCALES[language]}
              data-added-text={t.cart.addedShort}
            >
              <svg class="product-page__check" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5 12l5 5L20 7" />
              </svg>
              <span data-add-text>{t.cart.add}</span>
            </button>
          </div>
          <p data-added hidden role="status">
            {t.cart.added} <a href="/carrito">{t.cart.viewCart}</a>
          </p>
          {data.whatsapp && (
            <p>
              <a
                class="button secondary product-page__consult"
                href={consultHref(data.whatsapp, data.product.name, data.product.slug)}
                target="_blank"
                rel="noopener"
              >
                <svg class="product-page__consult-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-5A8 8 0 1 1 21 12z" />
                </svg>
                {t.store.consultWhatsapp}
              </a>
            </p>
          )}
          {data.product.description && <p class="description">{data.product.description}</p>}
          <HowToBuy />
        </div>
      </div>
      {data.related.length > 0 && (
        <section class="shelf" aria-labelledby="related">
          <div class="shelf__head">
            <h2 class="shelf__title" id="related">{t.store.related}</h2>
          </div>
          <ul class="catalog">
            {data.related.map((p) => (
              <ProductCard product={p} />
            ))}
          </ul>
        </section>
      )}
    </Store>
  ) : (
    <Store title={t.store.productNotFoundTitle} index={false}>
      <h1>{t.store.productNotFoundTitle}</h1>
      <p>{t.store.productNotFound} <a href="/">{t.common.backToStore}</a></p>
    </Store>
  )
}

<script>
  import { addToCart, formatMoney, MAX_QUANTITY } from "../../scripts/cart";

  const button = document.querySelector<HTMLButtonElement>("[data-add-to-cart]");
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-variants] fieldset"));
  const price = document.querySelector<HTMLElement>("[data-price]");
  const chooseAll = document.querySelector<HTMLElement>("[data-choose-all]");
  const quantityInput = document.querySelector<HTMLInputElement>("[data-quantity]");
  const initialPrice = price?.textContent ?? "";

  /** Per variant, the checked pill (one radio per value). */
  const chosen = () =>
    groups.map((group) => {
      const option = group.querySelector<HTMLInputElement>("input:checked");
      return { group, option, ok: option !== null };
    });
  const amountOf = (all: ReturnType<typeof chosen>, base: number) =>
    all.reduce((sum, c) => sum + Number(c.option?.dataset.delta ?? 0), base);

  /** With every variant chosen, the exact price; otherwise the "Desde" one the server rendered. */
  function updatePrice(): void {
    if (!button || !price) return;
    const all = chosen();
    if (all.some((c) => !c.ok)) {
      price.textContent = initialPrice;
      return;
    }
    const d = button.dataset;
    price.textContent = formatMoney(amountOf(all, Number(d.amount)), d.currency ?? "ARS", d.locale ?? "es-AR");
    chooseAll?.setAttribute("hidden", "");
  }
  const main = document.querySelector<HTMLImageElement>("[data-gallery-main]");
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-thumb]"));
  document.querySelector("[data-thumbs]")?.removeAttribute("hidden");
  // The thumbnails swap the main photo (without JavaScript the <noscript> images show instead).
  function showPhoto(url: string): void {
    if (main) main.src = url;
    for (const t of thumbs) {
      if (t.dataset.thumb === url) t.setAttribute("aria-current", "true");
      else t.removeAttribute("aria-current");
    }
  }
  for (const t of thumbs) t.addEventListener("click", () => showPhoto(t.dataset.thumb ?? ""));

  // The photo of an option value, when it has one: the last change wins.
  const optionPhoto = (c: ReturnType<typeof chosen>[number]) => c.option?.dataset.image || "";
  document.querySelector("[data-variants]")?.addEventListener("change", (e) => {
    const url = (e.target as HTMLInputElement | null)?.dataset.image;
    if (url) showPhoto(url);
    updatePrice();
  });
  // The browser may restore the chosen values (back/forward): the photo and price follow them without a change.
  function applyRestored(): void {
    const url = chosen().map(optionPhoto).filter(Boolean).pop();
    if (url) showPhoto(url);
    updatePrice();
  }
  applyRestored();
  window.addEventListener("pageshow", (e) => {
    if (e.persisted) applyRestored();
  });

  // Quantity: 1 to MAX_QUANTITY; a blank or garbled number counts as 1.
  const quantity = () => Math.max(1, Math.min(MAX_QUANTITY, Math.round(Number(quantityInput?.value)) || 1));
  for (const step of document.querySelectorAll<HTMLButtonElement>("[data-step]")) {
    step.addEventListener("click", () => {
      if (!quantityInput) return;
      quantityInput.value = String(Math.max(1, Math.min(MAX_QUANTITY, quantity() + Number(step.dataset.step))));
    });
  }

  // "Agregado" with a check for a moment, then the button reads "Agregar al carrito" again.
  const addText = button?.querySelector<HTMLElement>("[data-add-text]");
  const addLabel = addText?.textContent ?? "";
  let addedTimer: ReturnType<typeof setTimeout> | undefined;
  function showAdded(): void {
    if (addText) addText.textContent = button?.dataset.addedText ?? addLabel;
    button?.classList.add("product-page__add--added");
    clearTimeout(addedTimer);
    addedTimer = setTimeout(() => {
      if (addText) addText.textContent = addLabel;
      button?.classList.remove("product-page__add--added");
    }, 2000);
  }

  button?.addEventListener("click", () => {
    const d = button.dataset;
    const all = chosen();
    const missing = all.find((c) => !c.ok);
    if (missing) {
      chooseAll?.removeAttribute("hidden");
      missing.group.querySelector<HTMLInputElement>("input")?.focus();
      return;
    }
    addToCart(
      {
        productId: d.productId ?? "",
        slug: d.slug ?? "",
        name: d.name ?? "",
        // Preview only: the cart is priced again on the server.
        amount: amountOf(all, Number(d.amount)),
        currency: d.currency ?? "ARS",
        // The photo of the first option (product order) whose value has one, else the main photo.
        image: all.map(optionPhoto).find(Boolean) || d.image || null,
        ...(all.length > 0
          ? {
              selection: Object.fromEntries(all.map((c) => [c.group.dataset.optionId ?? "", c.option?.value ?? ""])),
              variant: all.map((c) => `${c.group.dataset.optionName}: ${c.option?.dataset.label}`).join(" · "),
            }
          : {}),
      },
      quantity(),
    );
    if (quantityInput) quantityInput.value = "1";
    showAdded();
    document.querySelector<HTMLElement>("[data-added]")?.removeAttribute("hidden");
  });
</script>
