---
import { env } from "cloudflare:workers";
import { textos } from "../../i18n";
import Store from "../../layouts/store.astro";
import { datosProducto } from "../../lib/paginas";

const t = textos(Astro.locals.idioma);
const datos = await datosProducto(env, Astro.params.slug ?? "", Astro.url.origin, Astro.locals.idioma);
if (!datos.encontrado) Astro.response.status = 404;
---

{
  datos.encontrado ? (
    <Store title={datos.producto.nombre} description={datos.producto.descripcion}>
      <script slot="head" type="application/ld+json" is:inline set:html={datos.jsonLd} />
      <p><a href="/">← {t.comun.volverALaTienda}</a></p>
      <h1>{datos.producto.nombre}</h1>
      {datos.producto.imagenes.map((img) => (
        <img src={img.url} alt={datos.producto.nombre} width="480" height="480" />
      ))}
      <p class="precio">{datos.producto.precioTexto}</p>
      {datos.producto.descripcion && <p>{datos.producto.descripcion}</p>}
    </Store>
  ) : (
    <Store title={t.tienda.productoNoEncontradoTitulo}>
      <h1>{t.tienda.productoNoEncontradoTitulo}</h1>
      <p>{t.tienda.productoNoEncontrado} <a href="/">{t.comun.volverALaTienda}</a></p>
    </Store>
  )
}
