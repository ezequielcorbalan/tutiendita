{
  // Generated by scripts/generate-tiendita.mjs from the tutiendita monorepo (changes belong there).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiendita",
  // Entry of the @astrojs/cloudflare adapter: `astro build` generates dist/server/wrangler.json and
  // `wrangler deploy` finds it on its own.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [ "nodejs_compat" ],
  "assets": { "binding": "ASSETS" },
  // No IDs on purpose: `npm run deploy` creates the D1 database if missing (scripts/prepare-d1.mjs) and
  // `wrangler deploy` creates the R2 bucket. The names follow the Worker's (<worker>-db,
  // <worker>-imagenes, like wrangler's provisioning): if you rename the Worker, rename these two
  // as well, so two stores in the same account never share data.
  "d1_databases": [{ "binding": "DB", "database_name": "tiendita-db", "migrations_dir": "migraciones" }],
  "r2_buckets": [{ "binding": "IMAGENES", "bucket_name": "tiendita-imagenes" }]
}
